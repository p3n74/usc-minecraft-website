# Server (required in production)
DATABASE_URL=postgres://usc:usc@localhost:5432/usc_forum
# DATABASE_SSL=true
PORT=3000
STATIC_ROOT=dist

# Local Vite (proxy /api). Production: https://usc.citadel-codex.com
PUBLIC_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Google OAuth — redirect must match the browser origin (Vite in local, site in prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
